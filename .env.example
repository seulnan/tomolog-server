# Copy to .env and fill in. Never commit real secrets (SPEC §2).

# --- Database (prod profile) ---
DB_URL=jdbc:postgresql://localhost:5432/tomolog
DB_USERNAME=tomolog
DB_PASSWORD=tomolog

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT (HS256, must be >= 32 bytes) ---
JWT_SECRET=change-me-to-a-long-random-secret-0123456789

# --- OAuth2 (Google / Kakao). Without these, use POST /api/auth/dev-login under local/test. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
